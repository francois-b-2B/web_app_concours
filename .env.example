# Chaîne de connexion Postgres (copier depuis Neon : neon.tech → ton projet → Connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé secrète Auth.js — génère-en une avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# Identifiants OAuth Google (Google Cloud Console → Identifiants → ID client OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
